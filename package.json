{
  "name": "invoice-management",
  "version": "0.7.23",
  "private": true,
  "description": "本地 PaddleOCR 驱动的智能发票管理桌面应用",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/with-local-temp.mjs node_modules/electron-vite/bin/electron-vite.js dev --noSandbox -- --user-data-dir=.tmp/dev-user-data",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && node scripts/with-local-temp.mjs node_modules/electron-vite/bin/electron-vite.js build",
    "test": "node scripts/with-local-temp.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/with-local-temp.mjs node_modules/vitest/vitest.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "build:ocr": "node scripts/prepare-ocr-runtime.mjs",
    "dist:win": "npm run build:ocr && npm run verify:release && npm run build && node scripts/prepare-electron-dist.mjs && node scripts/with-local-temp.mjs node_modules/electron-builder/out/cli/cli.js --win --x64",
    "postinstall": "node scripts/check-native.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "^0.1.80",
    "better-sqlite3": "13.0.3",
    "element-plus": "^2.11.8",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "ignore": "7.0.5",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13",
    "vue-tsc": "^3.1.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.8",
    "minimatch@>=7 <11.0.1": "11.0.5",
    "glob@>=9 <=14.0.1": "14.0.4",
    "unzipper": "0.12.5"
  }
}
